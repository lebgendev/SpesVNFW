SCENE "scene1":
    PLAYAUDIO "bg/bg.mp3"
    BG "sakuraBG.jpg"
    SHOW "arthur.png"
    DIALOGUE "Arthur" "You two done?"
    DIALOGUE "You & Emilia" "ARTHUR MORGAN?!!!"
    DIALOGUE "Arthur" "Been standin' here for ten minutes. Nobody noticed."
    CHOICES "Ask why he's here" "Run" "Offer handshake"

    CHOICE "Ask why he's here":
        DIALOGUE "You" "...Why are you here, Arthur?"
        DIALOGUE "Arthur" "Debt collection. But not for you. Yet."
        CHOICES "Press him harder" "Back off"

        CHOICE "Press him harder":
            DIALOGUE "You" "Who sent you?"
            SHOW "man.png"
            DIALOGUE "Man" "I did."
            DIALOGUE "You & Emilia" "WHO ARE YOU?!"
            DIALOGUE "Man" "Scene two."
            JUMPTOSCENE "scene2"

        CHOICE "Back off":
            DIALOGUE "You" "...Fine."
            DIALOGUE "Arthur" "Smart."
            JUMPTOSCENE "scene2"

    CHOICE "Run":
        SHOW "EmiliaShocked.png"
        DIALOGUE "Emilia" "Y/N WHAT ARE YOU DOING—"
        DIALOGUE "You" "RUNNING."
        SHOW "arthur.png"
        DIALOGUE "Arthur" "...I've got a horse."
        JUMPTOSCENE "chase"

    CHOICE "Offer handshake":
        DIALOGUE "You" "Arthur Morgan."
        SHOW "arthur.png"
        DIALOGUE "Arthur" "*shakes hand*"
        DIALOGUE "Arthur" "You've got nerve."
        JUMPTOSCENE "scene2"



SCENE "scene2":
    BG "classroom.jpg"
    PLAYAUDIO "bg/mystery.mp3"
    SHOW "man.png"
    DIALOGUE "Man" "Welcome."
    DIALOGUE "You" "To what?"
    DIALOGUE "Man" "A game."
    SHOW "EmiliaShocked.png"
    DIALOGUE "Emilia" "I don't like this."
    DIALOGUE "Arthur" "You shouldn't."

    CHOICES "Ask rules" "Refuse" "Look around"

    CHOICE "Ask rules":
        DIALOGUE "You" "What game?"
        DIALOGUE "Man" "Survival."
        DIALOGUE "Arthur" "...Figures."
        JUMPTOSCENE "scene3"

    CHOICE "Refuse":
        DIALOGUE "You" "We're not playing."
        DIALOGUE "Man" "You already are."
        BG "door_locked.jpg"
        DIALOGUE "Emilia" "The door is locked!"
        JUMPTOSCENE "scene3"

    CHOICE "Look around":
        DIALOGUE "You" "There's something on the desk."
        SHOW "note.png"
        DIALOGUE "You" "It says: 'Only one leaves.'"
        SHOW "EmiliaShocked.png"
        DIALOGUE "Emilia" "...What?"
        JUMPTOSCENE "scene3"



SCENE "scene3":
    BG "hallway.jpg"
    PLAYAUDIO "bg/tension.mp3"
    DIALOGUE "Arthur" "Stay close."
    SHOW "EmiliaShy.png"
    DIALOGUE "Emilia" "I don't like this place..."
    DIALOGUE "You" "Neither do I."

    CHOICES "Go left" "Go right" "Stay"

    CHOICE "Go left":
        BG "dark_room.jpg"
        DIALOGUE "You" "It's dark."
        SHOW "man.png"
        DIALOGUE "Man" "Good choice."
        JUMPTOSCENE "trap"

    CHOICE "Go right":
        BG "stairs.jpg"
        DIALOGUE "Arthur" "Stairs."
        SHOW "EmiliaHappy.png"
        DIALOGUE "Emilia" "An exit?!"
        DIALOGUE "Arthur" "Or bait."
        JUMPTOSCENE "stairs"

    CHOICE "Stay":
        DIALOGUE "Arthur" "Standing still gets you killed."
        BG "lights_off.jpg"
        DIALOGUE "You" "...Uh."
        JUMPTOSCENE "trap"



SCENE "trap":
    PLAYAUDIO "bg/impact.mp3"
    BG "trap_room.jpg"
    SHOW "EmiliaShocked.png"
    DIALOGUE "Emilia" "THE FLOOR MOVED—"
    DIALOGUE "You" "We're trapped."
    SHOW "man.png"
    DIALOGUE "Man" "First test."
    CHOICES "Protect Emilia" "Let Arthur handle it"

    CHOICE "Protect Emilia":
        DIALOGUE "You" "Stay behind me."
        DIALOGUE "Arthur" "...Kid's got guts."
        JUMPTOSCENE "scene4"

    CHOICE "Let Arthur handle it":
        DIALOGUE "Arthur" "Step back."
        DIALOGUE "Arthur" "*shoots lock*"
        BG "door_open.jpg"
        JUMPTOSCENE "scene4"



SCENE "stairs":
    BG "roof.jpg"
    SHOW "EmiliaHappy.png"
    DIALOGUE "Emilia" "We made it!"
    SHOW "man.png"
    DIALOGUE "Man" "Did you?"
    DIALOGUE "You" "...Of course not."
    JUMPTOSCENE "scene4"



SCENE "scene4":
    PLAYAUDIO "bg/finale.mp3"
    BG "arena.jpg"
    SHOW "man.png"
    DIALOGUE "Man" "Final round."
    DIALOGUE "Arthur" "Knew it."
    SHOW "EmiliaShocked.png"
    DIALOGUE "Emilia" "What do we do?"

    CHOICES "Fight" "Run" "Talk"

    CHOICE "Fight":
        DIALOGUE "You" "We end this."
        DIALOGUE "Arthur" "...I like that."
        DIALOGUE "Man" "Bold."
        JUMPTOSCENE "ending_fight"

    CHOICE "Run":
        DIALOGUE "You" "RUN."
        SHOW "EmiliaShocked.png"
        DIALOGUE "Emilia" "AGAIN?!"
        JUMPTOSCENE "ending_escape"

    CHOICE "Talk":
        DIALOGUE "You" "What do you want?"
        DIALOGUE "Man" "...Interesting."
        JUMPTOSCENE "ending_truth"



SCENE "ending_fight":
    BG "explosion.jpg"
    DIALOGUE "Arthur" "That went poorly."
    DIALOGUE "You" "...But we're alive."
    DIALOGUE "Emilia" "Barely."
    DIALOGUE "END" "FIGHT ENDING"



SCENE "ending_escape":
    BG "forest.jpg"
    DIALOGUE "Emilia" "We actually escaped..."
    DIALOGUE "Arthur" "For now."
    DIALOGUE "END" "ESCAPE ENDING"



SCENE "ending_truth":
    SHOW "man.png"
    DIALOGUE "Man" "You're being tested."
    DIALOGUE "You" "By who?"
    DIALOGUE "Man" "Scene two."
    DIALOGUE "END" "TRUTH ENDING"