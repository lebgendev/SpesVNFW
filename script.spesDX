SCENE "scene1":
    BG "sakuraBG.jpg"
    SHOW "EmiliaHappy.png"
    DIALOGUE "Emilia" "Y/N! You're late again!"
    DIALOGUE "You" "I was only five minutes late."
    SHOW "EmiliaAngry.png"
    DIALOGUE "Emilia" "FIVE MINUTES IS FIVE MINUTES!"
    DIALOGUE "You" "You look really cute when you're angry, you know that?"
    SHOW "EmiliaShy.png"
    DIALOGUE "Emilia" "D-Don't change the subject!! ...Did you really mean that?"
    TRANSITION "fade" "schoolHallwayBG.jpg"
    SHOW "arthur.png"
    DIALOGUE "Arthur" "You two done?"
    DIALOGUE "You & Emilia" "ARTHUR MORGAN?!!!"
    DIALOGUE "Arthur" "Been standin' here for ten minutes. Nobody noticed."
    CHOICES "Ask why he's here" "Run" "Offer handshake"

    CHOICE "Ask why he's here":
        DIALOGUE "You" "...Why are you here, Arthur?"
        DIALOGUE "Arthur" "Debt collection. But not for you. Yet."
        SHOW "EmiliaAngry.png"
        DIALOGUE "Emilia" "Debt from WHO?!"
        DIALOGUE "Arthur" "That ain't your concern, miss."
        CHOICES "Press him harder" "Back off and investigate later"

        CHOICE "Press him harder":
            DIALOGUE "You" "Arthur. I'm not dropping this. Who sent you?"
            SHOW "arthur.png"
            DIALOGUE "Arthur" "You really want to know?"
            DIALOGUE "Arthur" "Fine. There's a man. Goes by no name. Watches everything."
            SHOW "man.png"
            DIALOGUE "Man" "You called?"
            DIALOGUE "You & Emilia" "WHO ARE YOU?!"
            DIALOGUE "Man" "Patience. All will be explained."
            SHOW "EmiliaAngry.png"
            DIALOGUE "Emilia" "EXPLAIN IT NOW THEN—"
            SHOW "man.png"
            DIALOGUE "Man" "Scene two."
            DIALOGUE "You" "Did he just… tell us to wait for scene two?"
            SHOW "arthur.png"
            DIALOGUE "Arthur" "He does that. You get used to it."
            JUMPTOSCENE "scene2_A"

        CHOICE "Back off and investigate later":
            DIALOGUE "You" "...Fine. But this isn't over."
            SHOW "EmiliaShy.png"
            DIALOGUE "Emilia" "Y/N… I don't like any of this."
            DIALOGUE "You" "Neither do I. We'll figure it out on our own."
            SHOW "EmiliaHappy.png"
            DIALOGUE "Emilia" "Together?"
            DIALOGUE "You" "Together."
            SHOW "arthur.png"
            DIALOGUE "Arthur" "Sweet. Now move along."
            SHOW "EmiliaAngry.png"
            DIALOGUE "Emilia" "YOU DON'T GET TO TELL US TO MOVE ALONG—"
            SHOW "arthur.png"
            DIALOGUE "Arthur" "I really do though."
            JUMPTOSCENE "scene2_B"

    CHOICE "Run":
        SHOW "EmiliaShocked.png"
        DIALOGUE "Emilia" "Y/N WHAT ARE YOU DOING—"
        DIALOGUE "You" "RUNNING. OBVIOUSLY."
        DIALOGUE "Emilia" "FROM ARTHUR MORGAN?!"
        DIALOGUE "You" "ESPECIALLY FROM ARTHUR MORGAN."
        SHOW "arthur.png"
        DIALOGUE "Arthur" "...I've got a horse."
        SHOW "EmiliaShocked.png"
        DIALOGUE "Emilia" "HE'S GETTING ON THE HORSE Y/N—"
        CHOICES "Split up" "Hide together"

        CHOICE "Split up":
            DIALOGUE "You" "Emilia — you go left, I go right, meet at the sakura tree!"
            SHOW "EmiliaShy.png"
            DIALOGUE "Emilia" "If you get caught I will never forgive you!!"
            DIALOGUE "You" "I won't. GO!"
            SHOW "arthur.png"
            DIALOGUE "Arthur" "...They split up. Amateurs."
            SHOW "man.png"
            DIALOGUE "Man" "Interesting tactic."
            DIALOGUE "Arthur" "It ain't a tactic. It's panic."
            DIALOGUE "Man" "Same thing, sometimes."
            SHOW "EmiliaShocked.png"
            DIALOGUE "Emilia" "Y/N!! I made it!! Did you—"
            DIALOGUE "You" "Right behind you. Barely."
            SHOW "EmiliaHappy.png"
            DIALOGUE "Emilia" "Don't you EVER do that again!!"
            DIALOGUE "You" "No promises."
            SHOW "EmiliaAngry.png"
            DIALOGUE "Emilia" "Y/NNNN—"
            JUMPTOSCENE "scene2_C"

        CHOICE "Hide together":
            DIALOGUE "You" "In here — quick!"
            SHOW "EmiliaShy.png"
            DIALOGUE "Emilia" "This is a SUPPLY CLOSET Y/N—"
            DIALOGUE "You" "Shhhh!"
            DIALOGUE "Emilia" "...It smells like chalk."
            DIALOGUE "You" "Emilia. Shhhh."
            SHOW "arthur.png"
            DIALOGUE "Arthur" "I can hear you both breathing."
            DIALOGUE "You & Emilia" "..."
            DIALOGUE "Arthur" "Come out. I ain't gonna hurt you."
            CHOICES "Trust him and come out" "Stay in the closet"

            CHOICE "Trust him and come out":
                DIALOGUE "You" "...Okay. We're coming out."
                SHOW "EmiliaShy.png"
                DIALOGUE "Emilia" "If he shoots us it's your fault."
                SHOW "arthur.png"
                DIALOGUE "Arthur" "I said I wasn't gonna hurt you. I meant it."
                DIALOGUE "You" "...Alright. What do you want, Arthur?"
                DIALOGUE "Arthur" "Just to talk."
                SHOW "EmiliaShocked.png"
                DIALOGUE "Emilia" "ARTHUR MORGAN WANTS TO TALK?!"
                DIALOGUE "Arthur" "I'm capable of conversation, miss."
                JUMPTOSCENE "scene2_A"

            CHOICE "Stay in the closet":
                DIALOGUE "You" "...We're good in here actually."
                SHOW "arthur.png"
                DIALOGUE "Arthur" "..."
                DIALOGUE "Arthur" "Fine. I'll wait."
                SHOW "EmiliaShy.png"
                DIALOGUE "Emilia" "...Y/N he's just standing there."
                DIALOGUE "You" "I know."
                DIALOGUE "Emilia" "...He's been standing there for ten minutes."
                DIALOGUE "You" "I know."
                DIALOGUE "Emilia" "...Y/N I need to use the bathroom."
                DIALOGUE "You" "EMILIA—"
                SHOW "arthur.png"
                DIALOGUE "Arthur" "Come out whenever you're ready. I've got time."
                SHOW "man.png"
                DIALOGUE "Man" "This is going well."
                JUMPTOSCENE "scene2_B"

    CHOICE "Offer handshake":
        SHOW "EmiliaShy.png"
        DIALOGUE "Emilia" "Y/N WHAT ARE YOU—"
        DIALOGUE "You" "Arthur Morgan. I've heard a lot about you."
        SHOW "arthur.png"
        DIALOGUE "Arthur" "...Have you now."
        DIALOGUE "You" "Legendary outlaw. Terrible fashion sense. Good heart."
        SHOW "EmiliaShocked.png"
        DIALOGUE "Emilia" "Y/N you can't just SAY THAT—"
        SHOW "arthur.png"
        DIALOGUE "Arthur" "...Hah."
        DIALOGUE "Arthur" "*shakes hand* You've got nerve, kid. I respect that."
        CHOICES "Ask him to join us" "Compliment his horse"

        CHOICE "Ask him to join us":
            DIALOGUE "You" "We could use someone capable. Someone who knows how the world works."
            SHOW "arthur.png"
            DIALOGUE "Arthur" "You're asking a wanted outlaw to join your... whatever this is."
            DIALOGUE "You" "Yes."
            DIALOGUE "Arthur" "...Give me one good reason."
            DIALOGUE "You" "Because you're already here and you haven't left."
            SHOW "arthur.png"
            DIALOGUE "Arthur" "...That's fair."
            SHOW "EmiliaHappy.png"
            DIALOGUE "Emilia" "I can't believe that worked."
            SHOW "arthur.png"
            DIALOGUE "Arthur" "Don't make me regret it."
            JUMPTOSCENE "scene2_A"

        CHOICE "Compliment his horse":
            DIALOGUE "You" "Is that a Thoroughbred? She's beautiful."
            SHOW "arthur.png"
            DIALOGUE "Arthur" "...You know horses?"
            DIALOGUE "You" "A little. She's got good legs."
            SHOW "arthur.png"
            DIALOGUE "Arthur" "Her name's Charlotte. And yeah. She's the best."
            SHOW "EmiliaShy.png"
            DIALOGUE "Emilia" "...Y/N you just made friends with Arthur Morgan by complimenting a horse."
            DIALOGUE "You" "I contain multitudes."
            SHOW "arthur.png"
            DIALOGUE "Arthur" "Kid's alright. Come on then."
            JUMPTOSCENE "scene2_C"


SCENE "scene2_A":
    BG "schoolHallwayBG.jpg"
    SHOW "man.png"
    DIALOGUE "Man" "So. You wanted answers."
    DIALOGUE "You" "We want to know who you are and what you want."
    SHOW "man.png"
    DIALOGUE "Man" "I am simply… an observer. Of stories. Of people."
    SHOW "EmiliaAngry.png"
    DIALOGUE "Emilia" "That tells us literally nothing."
    SHOW "man.png"
    DIALOGUE "Man" "I've been watching this particular story for some time."
    DIALOGUE "Man" "You two are… interesting. More than you know."
    TRANSITION "fade" "sakuraBG.jpg"
    SHOW "EmiliaShy.png"
    DIALOGUE "Emilia" "What does that mean? More than we know?"
    SHOW "man.png"
    DIALOGUE "Man" "It means the choices you make here have weight."
    DIALOGUE "Man" "Real weight. Beyond this hallway. Beyond this school."
    DIALOGUE "You" "You're being deliberately cryptic."
    SHOW "man.png"
    DIALOGUE "Man" "Yes. It's a habit."
    SHOW "arthur.png"
    DIALOGUE "Arthur" "Told you. Three days I argued with him. Don't bother."
    CHOICES "Demand he speak plainly" "Accept it and ask what's next" "Ask Arthur what he knows"

    CHOICE "Demand he speak plainly":
        DIALOGUE "You" "No more riddles. Plainly. What do you want from us?"
        SHOW "man.png"
        DIALOGUE "Man" "...Very well."
        DIALOGUE "Man" "There is something coming. Something that will test everything between you two."
        DIALOGUE "Man" "I am here to make sure you are ready."
        SHOW "EmiliaShocked.png"
        DIALOGUE "Emilia" "Test… everything between us?"
        SHOW "man.png"
        DIALOGUE "Man" "Your trust. Your honesty. Your feelings for each other."
        SHOW "EmiliaShy.png"
        DIALOGUE "Emilia" "I— our feelings are— I mean we don't— I don't—"
        DIALOGUE "You" "Emilia."
        DIALOGUE "Emilia" "...What."
        DIALOGUE "You" "Breathe."
        DIALOGUE "Emilia" "...Right. Breathing."
        SHOW "arthur.png"
        DIALOGUE "Arthur" "You two need to sort yourselves out before whatever's coming."
        CHOICES "Agree" "Deny there's anything to sort out"

        CHOICE "Agree":
            DIALOGUE "You" "He's right. Emilia… we should talk."
            SHOW "EmiliaShy.png"
            DIALOGUE "Emilia" "T-Talk? About what exactly?"
            DIALOGUE "You" "About us."
            SHOW "EmiliaShocked.png"
            DIALOGUE "Emilia" "There's an US?!"
            DIALOGUE "You" "Isn't there?"
            SHOW "EmiliaShy.png"
            DIALOGUE "Emilia" "...I… yes. Maybe. Probably. Don't look at me like that."
            SHOW "arthur.png"
            DIALOGUE "Arthur" "Progress."
            JUMPTOSCENE "scene3_A"

        CHOICE "Deny there's anything to sort out":
            DIALOGUE "You" "We're fine. Nothing to sort out."
            SHOW "arthur.png"
            DIALOGUE "Arthur" "Son."
            DIALOGUE "You" "What."
            DIALOGUE "Arthur" "You're holding her hand right now."
            SHOW "EmiliaShocked.png"
            DIALOGUE "Emilia" "W— Y/N WHEN DID THAT HAPPEN—"
            DIALOGUE "You" "I… have no explanation for this."
            SHOW "man.png"
            DIALOGUE "Man" "The hand knows what the heart won't admit."
            DIALOGUE "You" "That's either very wise or very weird."
            DIALOGUE "Man" "Both, usually."
            JUMPTOSCENE "scene3_A"

    CHOICE "Accept it and ask what's next":
        DIALOGUE "You" "Fine. We accept that. What do we do now?"
        SHOW "man.png"
        DIALOGUE "Man" "Now you face the first trial."
        SHOW "EmiliaAngry.png"
        DIALOGUE "Emilia" "Of COURSE there are trials."
        DIALOGUE "Man" "Three of them."
        SHOW "EmiliaAngry.png"
        DIALOGUE "Emilia" "OF COURSE THERE ARE THREE."
        SHOW "arthur.png"
        DIALOGUE "Arthur" "What are the trials?"
        SHOW "man.png"
        DIALOGUE "Man" "Honesty. Courage. Sacrifice."
        DIALOGUE "You" "In that order?"
        DIALOGUE "Man" "In whatever order fate chooses."
        SHOW "EmiliaShy.png"
        DIALOGUE "Emilia" "Y/N… I'm nervous."
        DIALOGUE "You" "Don't be. We do this together."
        SHOW "EmiliaHappy.png"
        DIALOGUE "Emilia" "...Yeah. Together."
        JUMPTOSCENE "scene3_B"

    CHOICE "Ask Arthur what he knows":
        DIALOGUE "You" "Arthur. You've dealt with this man before. What do you actually know?"
        SHOW "arthur.png"
        DIALOGUE "Arthur" "More than I'd like."
        DIALOGUE "Arthur" "He showed up in my story at the worst possible time."
        DIALOGUE "Arthur" "Made me look at things I didn't want to look at."
        DIALOGUE "You" "Like what?"
        SHOW "arthur.png"
        DIALOGUE "Arthur" "Like whether the life I was living was worth living."
        DIALOGUE "Arthur" "...Don't waste time like I did, kid."
        SHOW "EmiliaShy.png"
        DIALOGUE "Emilia" "Arthur… that's…"
        DIALOGUE "Arthur" "Don't get sentimental. I'm just giving you context."
        DIALOGUE "You" "Noted. And… thank you."
        SHOW "arthur.png"
        DIALOGUE "Arthur" "Don't thank me. Just don't be an idiot."
        SHOW "man.png"
        DIALOGUE "Man" "Well said."
        DIALOGUE "Arthur" "Shut up."
        JUMPTOSCENE "scene3_A"


SCENE "scene2_B":
    BG "schoolHallwayBG.jpg"
    SHOW "EmiliaShy.png"
    DIALOGUE "Emilia" "Y/N… we're doing this alone? No Arthur, no mysterious man?"
    DIALOGUE "You" "Just us figuring it out. Like normal people."
    SHOW "EmiliaHappy.png"
    DIALOGUE "Emilia" "We are very far from normal people right now."
    DIALOGUE "You" "Fair point."
    TRANSITION "fade" "sakuraBG.jpg"
    SHOW "EmiliaShy.png"
    DIALOGUE "Emilia" "Okay. What do we actually know?"
    DIALOGUE "You" "Arthur's here for debt collection. Someone sent him. That someone is watching us."
    DIALOGUE "Emilia" "Why us though? What's special about us?"
    DIALOGUE "You" "I genuinely don't know."
    SHOW "EmiliaHappy.png"
    DIALOGUE "Emilia" "...Well. We've handled weird before."
    DIALOGUE "You" "Have we?"
    DIALOGUE "Emilia" "You literally said 'who's a good boy' to me earlier today."
    DIALOGUE "You" "That was— I was testing something."
    SHOW "EmiliaAngry.png"
    DIALOGUE "Emilia" "YOU WERE TESTING NOTHING—"
    CHOICES "Laugh it off" "Apologize properly" "Change the subject urgently"

    CHOICE "Laugh it off":
        DIALOGUE "You" "Okay okay, you got me. It was weird. I panicked."
        SHOW "EmiliaShy.png"
        DIALOGUE "Emilia" "You PANICKED and said 'who's a good boy'?!"
        DIALOGUE "You" "My brain does strange things around you."
        DIALOGUE "Emilia" "...That's either very sweet or very concerning."
        DIALOGUE "You" "Probably both."
        SHOW "EmiliaHappy.png"
        DIALOGUE "Emilia" "...You're impossible."
        DIALOGUE "You" "But you're still here."
        SHOW "EmiliaShy.png"
        DIALOGUE "Emilia" "...Shut up."
        SHOW "man.png"
        DIALOGUE "Man" "How heartwarming. Are you done?"
        DIALOGUE "You & Emilia" "WHERE DID YOU COME FROM—"
        DIALOGUE "Man" "I never left."
        JUMPTOSCENE "scene3_A"

    CHOICE "Apologize properly":
        DIALOGUE "You" "Emilia. For real. I'm sorry. That was strange and I shouldn't have."
        SHOW "EmiliaShocked.png"
        DIALOGUE "Emilia" "A… a real apology?"
        DIALOGUE "You" "A real apology."
        SHOW "EmiliaShy.png"
        DIALOGUE "Emilia" "I… okay. I forgive you."
        DIALOGUE "Emilia" "...Don't do it again."
        DIALOGUE "You" "No promises. You bring it out of me."
        SHOW "EmiliaAngry.png"
        DIALOGUE "Emilia" "THAT IS NOT AN ACCEPTABLE FOLLOW-UP TO AN APOLOGY—"
        SHOW "arthur.png"
        DIALOGUE "Arthur" "Found you."
        DIALOGUE "You & Emilia" "ARTHUR—"
        DIALOGUE "Arthur" "Relax. I just want to talk."
        JUMPTOSCENE "scene3_A"

    CHOICE "Change the subject urgently":
        DIALOGUE "You" "ANYWAY. The mysterious man. What do we know about him."
        SHOW "EmiliaAngry.png"
        DIALOGUE "Emilia" "We are NOT done with the 'good boy' thing—"
        DIALOGUE "You" "The mysterious man, Emilia—"
        DIALOGUE "Emilia" "Y/N—"
        DIALOGUE "You" "MYSTERIOUS. MAN."
        SHOW "EmiliaShy.png"
        DIALOGUE "Emilia" "...Fine. But we're coming back to it."
        DIALOGUE "You" "We absolutely are not."
        SHOW "man.png"
        DIALOGUE "Man" "If it helps, I found the whole exchange delightful."
        DIALOGUE "You" "It does not help."
        DIALOGUE "Man" "I know."
        JUMPTOSCENE "scene3_B"


SCENE "scene2_C":
    BG "sakuraBG.jpg"
    SHOW "EmiliaHappy.png"
    DIALOGUE "Emilia" "Okay. So we're under the sakura tree. Arthur is… here. Somehow this is our life now."
    DIALOGUE "You" "Could be worse."
    SHOW "EmiliaShy.png"
    DIALOGUE "Emilia" "Could it though?"
    DIALOGUE "You" "He's not shooting at us."
    DIALOGUE "Emilia" "...Low bar, Y/N."
    SHOW "arthur.png"
    DIALOGUE "Arthur" "I can hear you both."
    SHOW "EmiliaAngry.png"
    DIALOGUE "Emilia" "WE KNOW."
    TRANSITION "fade" "schoolHallwayBG.jpg"
    SHOW "arthur.png"
    DIALOGUE "Arthur" "Listen. I'll be straight with you two."
    DIALOGUE "Arthur" "That man who's been watching you. He's real. He's not dangerous, exactly."
    DIALOGUE "Arthur" "But he has a way of making things… complicated."
    DIALOGUE "You" "Complicated how?"
    SHOW "arthur.png"
    DIALOGUE "Arthur" "He tests people. Finds the cracks. Presses on them."
    SHOW "EmiliaShy.png"
    DIALOGUE "Emilia" "Cracks in what?"
    SHOW "arthur.png"
    DIALOGUE "Arthur" "In whatever matters most to you."
    DIALOGUE "Arthur" "For you two… I think that's each other."
    SHOW "EmiliaShocked.png"
    DIALOGUE "Emilia" "That's— I— we're not— I mean—"
    SHOW "arthur.png"
    DIALOGUE "Arthur" "Miss. I've ridden with Dutch van der Linde. I know denial when I see it."
    CHOICES "Ask Arthur for advice" "Confront Emilia about it" "Pretend Arthur said nothing"

    CHOICE "Ask Arthur for advice":
        DIALOGUE "You" "Arthur. You've been tested. How do you get through it?"
        SHOW "arthur.png"
        DIALOGUE "Arthur" "Honestly?"
        DIALOGUE "Arthur" "Stop running from the thing you're most afraid of."
        DIALOGUE "You" "And what am I most afraid of?"
        SHOW "arthur.png"
        DIALOGUE "Arthur" "You already know."
        SHOW "EmiliaShy.png"
        DIALOGUE "Emilia" "...Y/N?"
        DIALOGUE "You" "...Yeah. I know."
        DIALOGUE "You" "Emilia. I need to tell you something."
        SHOW "EmiliaShocked.png"
        DIALOGUE "Emilia" "R-Right now?! Here?! In front of Arthur?!"
        SHOW "arthur.png"
        DIALOGUE "Arthur" "I'll look at the tree."
        DIALOGUE "Arthur" "...Nice tree."
        DIALOGUE "You" "Emilia. I like you. A lot. More than a lot."
        SHOW "EmiliaShy.png"
        DIALOGUE "Emilia" "Y/N… I…"
        DIALOGUE "Emilia" "...Me too. You idiot."
        SHOW "arthur.png"
        DIALOGUE "Arthur" "Good. Now we can move on."
        JUMPTOSCENE "scene3_B"

    CHOICE "Confront Emilia about it":
        DIALOGUE "You" "Emilia. Arthur's right, isn't he."
        SHOW "EmiliaAngry.png"
        DIALOGUE "Emilia" "Arthur is an outlaw from 1899 and his opinions are irrelevant—"
        DIALOGUE "You" "Emilia."
        SHOW "EmiliaShy.png"
        DIALOGUE "Emilia" "...What."
        DIALOGUE "You" "Do I matter to you?"
        DIALOGUE "Emilia" "..."
        DIALOGUE "Emilia" "...You know you do."
        DIALOGUE "You" "Then say it."
        SHOW "EmiliaShocked.png"
        DIALOGUE "Emilia" "I— in front of ARTHUR—"
        SHOW "arthur.png"
        DIALOGUE "Arthur" "I'm not here."
        SHOW "EmiliaShy.png"
        DIALOGUE "Emilia" "...Y/N. You matter to me. A lot. Happy?"
        DIALOGUE "You" "Very."
        SHOW "EmiliaAngry.png"
        DIALOGUE "Emilia" "Don't smirk like that!!"
        JUMPTOSCENE "scene3_B"

    CHOICE "Pretend Arthur said nothing":
        DIALOGUE "You" "Cool. Noted. Moving on. What do we do about the mysterious man?"
        SHOW "arthur.png"
        DIALOGUE "Arthur" "...You're going to ignore everything I just said."
        DIALOGUE "You" "Completely."
        SHOW "EmiliaHappy.png"
        DIALOGUE "Emilia" "Same."
        SHOW "arthur.png"
        DIALOGUE "Arthur" "You two are going to make this very hard on yourselves."
        DIALOGUE "You" "Probably."
        SHOW "man.png"
        DIALOGUE "Man" "Definitely."
        DIALOGUE "You" "WHEN DID YOU GET HERE—"
        SHOW "man.png"
        DIALOGUE "Man" "I've been here the whole time."
        DIALOGUE "Man" "Shall we begin the trials?"
        SHOW "EmiliaAngry.png"
        DIALOGUE "Emilia" "WHAT TRIALS—"
        JUMPTOSCENE "scene3_B"


SCENE "scene3_A":
    BG "sakuraBG.jpg"
    SHOW "man.png"
    DIALOGUE "Man" "The first trial is Honesty."
    SHOW "EmiliaShocked.png"
    DIALOGUE "Emilia" "Already?!"
    SHOW "man.png"
    DIALOGUE "Man" "You will each say one true thing. Something you have not said before."
    DIALOGUE "You" "To each other?"
    DIALOGUE "Man" "To each other."
    SHOW "EmiliaShy.png"
    DIALOGUE "Emilia" "I… I don't know if I can."
    DIALOGUE "You" "Yes you can. I'll go first."
    SHOW "arthur.png"
    DIALOGUE "Arthur" "Finally."
    TRANSITION "fade" "schoolHallwayBG.jpg"
    CHOICES "Confess your feelings" "Confess a fear" "Confess something embarrassing"

    CHOICE "Confess your feelings":
        DIALOGUE "You" "Emilia. The truth is… every day is better because you're in it."
        SHOW "EmiliaShocked.png"
        DIALOGUE "Emilia" "Y/N… that's—"
        DIALOGUE "You" "Your turn."
        SHOW "EmiliaShy.png"
        DIALOGUE "Emilia" "I… I think about you. A lot. More than I should probably."
        DIALOGUE "Emilia" "When you're not around I notice the quiet and I don't like it."
        SHOW "EmiliaHappy.png"
        DIALOGUE "Emilia" "There. That's my true thing."
        DIALOGUE "You" "...That's a really good true thing."
        SHOW "EmiliaShy.png"
        DIALOGUE "Emilia" "Shut UP—"
        SHOW "man.png"
        DIALOGUE "Man" "Trial one passed."
        SHOW "arthur.png"
        DIALOGUE "Arthur" "Took you long enough."
        CHOICES "Ask what's next" "Ask if you can have a moment"

        CHOICE "Ask what's next":
            DIALOGUE "You" "Okay. What's the second trial?"
            SHOW "man.png"
            DIALOGUE "Man" "Courage."
            SHOW "EmiliaAngry.png"
            DIALOGUE "Emilia" "Of COURSE it is."
            JUMPTOSCENE "scene4_A"

        CHOICE "Ask if you can have a moment":
            DIALOGUE "You" "Can we have… just a minute?"
            SHOW "man.png"
            DIALOGUE "Man" "...One minute."
            DIALOGUE "You" "Emilia. Hey."
            SHOW "EmiliaShy.png"
            DIALOGUE "Emilia" "Hey."
            DIALOGUE "You" "We're going to be okay."
            DIALOGUE "Emilia" "...Yeah?"
            DIALOGUE "You" "Yeah."
            SHOW "EmiliaHappy.png"
            DIALOGUE "Emilia" "...Okay. Let's do this."
            JUMPTOSCENE "scene4_A"

    CHOICE "Confess a fear":
        DIALOGUE "You" "I'm afraid of losing you. To any of this. To whatever comes next."
        SHOW "EmiliaShocked.png"
        DIALOGUE "Emilia" "Y/N…"
        DIALOGUE "You" "Your turn."
        SHOW "EmiliaShy.png"
        DIALOGUE "Emilia" "I'm afraid that one day you'll realize I'm not… worth all the trouble."
        DIALOGUE "You" "Emilia. That will never happen."
        DIALOGUE "Emilia" "You don't know that."
        DIALOGUE "You" "I know me. And I know you. And that will never happen."
        SHOW "EmiliaHappy.png"
        DIALOGUE "Emilia" "...You're going to make me cry and I refuse to cry in a school hallway."
        SHOW "arthur.png"
        DIALOGUE "Arthur" "Both of you are braver than you think."
        SHOW "man.png"
        DIALOGUE "Man" "Trial one passed. With distinction."
        JUMPTOSCENE "scene4_A"

    CHOICE "Confess something embarrassing":
        DIALOGUE "You" "I practiced what I'd say to you. In a mirror. Multiple times."
        SHOW "EmiliaShocked.png"
        DIALOGUE "Emilia" "...You WHAT."
        DIALOGUE "You" "Your turn."
        SHOW "EmiliaShy.png"
        DIALOGUE "Emilia" "I… I have a notebook. With your name in it."
        DIALOGUE "You" "A notebook."
        DIALOGUE "Emilia" "There may be… doodles."
        DIALOGUE "You" "Emilia."
        DIALOGUE "Emilia" "SHUT UP WE'RE BOTH EMBARRASSING—"
        SHOW "arthur.png"
        DIALOGUE "Arthur" "This is the most painfully relatable thing I have ever witnessed."
        SHOW "man.png"
        DIALOGUE "Man" "Trial one passed. Unexpectedly."
        JUMPTOSCENE "scene4_A"


SCENE "scene3_B":
    BG "schoolHallwayBG.jpg"
    SHOW "man.png"
    DIALOGUE "Man" "The trials begin now."
    SHOW "EmiliaAngry.png"
    DIALOGUE "Emilia" "What trials? Nobody agreed to trials!!"
    SHOW "man.png"
    DIALOGUE "Man" "You agreed by being here."
    DIALOGUE "You" "That's not how consent works."
    SHOW "man.png"
    DIALOGUE "Man" "In a story it is."
    SHOW "arthur.png"
    DIALOGUE "Arthur" "He's got a point, unfortunately."
    TRANSITION "fade" "sakuraBG.jpg"
    SHOW "man.png"
    DIALOGUE "Man" "Three trials. Honesty. Courage. Sacrifice."
    DIALOGUE "Man" "Fail any one and the story ends."
    SHOW "EmiliaShocked.png"
    DIALOGUE "Emilia" "Ends HOW—"
    SHOW "man.png"
    DIALOGUE "Man" "Unhappily."
    DIALOGUE "You" "Then we won't fail."
    SHOW "EmiliaHappy.png"
    DIALOGUE "Emilia" "...Right. We won't."
    SHOW "arthur.png"
    DIALOGUE "Arthur" "I'll be here. For whatever that's worth."
    SHOW "EmiliaShy.png"
    DIALOGUE "Emilia" "...Actually that's worth quite a lot."
    SHOW "arthur.png"
    DIALOGUE "Arthur" "Don't go soft on me, miss."
    DIALOGUE "Emilia" "Too late."
    CHOICES "Ask about the first trial" "Ask Arthur what he knows about the trials" "Ask if you can refuse"

    CHOICE "Ask about the first trial":
        DIALOGUE "You" "Tell us about the first trial."
        SHOW "man.png"
        DIALOGUE "Man" "Honesty. You must tell each other the thing you've been avoiding saying."
        SHOW "EmiliaShy.png"
        DIALOGUE "Emilia" "...Oh no."
        DIALOGUE "You" "Oh no?"
        DIALOGUE "Emilia" "I mean— I just mean— it's a lot of pressure—"
        DIALOGUE "You" "Emilia. Look at me."
        DIALOGUE "Emilia" "...What."
        DIALOGUE "You" "Whatever you say, I'm not going anywhere."
        SHOW "EmiliaHappy.png"
        DIALOGUE "Emilia" "...Promise?"
        DIALOGUE "You" "Promise."
        JUMPTOSCENE "scene4_A"

    CHOICE "Ask Arthur what he knows about the trials":
        DIALOGUE "You" "Arthur. You went through this. What were your trials?"
        SHOW "arthur.png"
        DIALOGUE "Arthur" "...Different from yours, I'd imagine."
        DIALOGUE "Arthur" "Mine were about loyalty. About whether a man's word means anything."
        DIALOGUE "Arthur" "Yours are about something simpler and harder at the same time."
        DIALOGUE "You" "What do you mean?"
        SHOW "arthur.png"
        DIALOGUE "Arthur" "Mine were about what I owed the world."
        DIALOGUE "Arthur" "Yours are about what you owe each other."
        SHOW "EmiliaShy.png"
        DIALOGUE "Emilia" "...Arthur. That was unexpectedly profound."
        DIALOGUE "Arthur" "I have my moments."
        DIALOGUE "You" "Thank you. Really."
        SHOW "arthur.png"
        DIALOGUE "Arthur" "Don't make it weird. Go do your trials."
        JUMPTOSCENE "scene4_A"

    CHOICE "Ask if you can refuse":
        DIALOGUE "You" "What if we just… don't?"
        SHOW "man.png"
        DIALOGUE "Man" "You could."
        DIALOGUE "You" "And?"
        DIALOGUE "Man" "And you'd spend the rest of this story wondering what would have happened."
        SHOW "EmiliaAngry.png"
        DIALOGUE "Emilia" "That's EMOTIONAL MANIPULATION—"
        SHOW "man.png"
        DIALOGUE "Man" "Yes."
        DIALOGUE "Man" "Is it working?"
        SHOW "EmiliaShy.png"
        DIALOGUE "Emilia" "...Unfortunately."
        DIALOGUE "You" "Fine. We'll do the trials."
        SHOW "man.png"
        DIALOGUE "Man" "Wonderful."
        SHOW "arthur.png"
        DIALOGUE "Arthur" "For what it's worth, kid — you're making the right call."
        JUMPTOSCENE "scene4_A"


SCENE "scene4_A":
    BG "schoolHallwayBG.jpg"
    SHOW "man.png"
    DIALOGUE "Man" "Trial two. Courage."
    SHOW "EmiliaAngry.png"
    DIALOGUE "Emilia" "What does COURAGE mean in this context?!"
    SHOW "man.png"
    DIALOGUE "Man" "You will face something you have been avoiding."
    DIALOGUE "Man" "For Y/N — a confrontation."
    DIALOGUE "Man" "For Emilia — a choice."
    SHOW "EmiliaShocked.png"
    DIALOGUE "Emilia" "What kind of choice?!"
    SHOW "man.png"
    DIALOGUE "Man" "Whether to stay."
    DIALOGUE "Emilia" "Stay… where?"
    DIALOGUE "Man" "Here. With Y/N. Knowing what comes next won't be easy."
    TRANSITION "fade" "sakuraBG.jpg"
    SHOW "EmiliaShy.png"
    DIALOGUE "Emilia" "Y/N… what's your confrontation?"
    DIALOGUE "You" "I think I already know."
    SHOW "arthur.png"
    DIALOGUE "Arthur" "Then say it out loud. Saying it makes it real. Real things can be dealt with."
    CHOICES "Confront your feelings directly" "Confront the Man" "Confront your own doubts"

    CHOICE "Confront your feelings directly":
        DIALOGUE "You" "Emilia. I want to be with you. Not just in the sense of being around you."
        DIALOGUE "You" "In the real sense. The choosing-each-other-every-day sense."
        SHOW "EmiliaShocked.png"
        DIALOGUE "Emilia" "Y/N… that's—"
        DIALOGUE "You" "I know it's terrifying. I know the timing is insane."
        DIALOGUE "You" "But I'm not going to keep pretending it's not true."
        SHOW "EmiliaShy.png"
        DIALOGUE "Emilia" "..."
        DIALOGUE "Emilia" "You couldn't have said that somewhere nicer? With fewer witnesses?"
        DIALOGUE "You" "There is never a good time. So now is as good as any."
        SHOW "EmiliaHappy.png"
        DIALOGUE "Emilia" "...You absolute idiot."
        DIALOGUE "Emilia" "Yes. Okay. Yes."
        SHOW "arthur.png"
        DIALOGUE "Arthur" "There it is."
        SHOW "man.png"
        DIALOGUE "Man" "Trial two passed."
        CHOICES "Ask about trial three" "Just hold the moment"

        CHOICE "Ask about trial three":
            DIALOGUE "You" "And the third trial?"
            SHOW "man.png"
            DIALOGUE "Man" "Sacrifice. But not yet."
            DIALOGUE "Man" "Rest first."
            JUMPTOSCENE "scene5_A"

        CHOICE "Just hold the moment":
            DIALOGUE "You" "Can we just… stay here for a second?"
            SHOW "EmiliaShy.png"
            DIALOGUE "Emilia" "...Yes. Please."
            SHOW "arthur.png"
            DIALOGUE "Arthur" "I'll go check on the horse."
            SHOW "man.png"
            DIALOGUE "Man" "I'll… also go check on the horse."
            DIALOGUE "Arthur" "You don't even like horses."
            DIALOGUE "Man" "I'm learning."
            JUMPTOSCENE "scene5_A"

    CHOICE "Confront the Man":
        DIALOGUE "You" "You. Tell me the real reason you're here."
        SHOW "man.png"
        DIALOGUE "Man" "I already told you—"
        DIALOGUE "You" "The REAL reason. Not the narrator speech. The actual reason."
        SHOW "man.png"
        DIALOGUE "Man" "..."
        DIALOGUE "Man" "Because stories like yours don't happen often."
        DIALOGUE "Man" "Two people who could genuinely be good for each other."
        DIALOGUE "Man" "Most of the time people like you just… miss each other."
        DIALOGUE "Man" "I didn't want that to happen here."
        SHOW "EmiliaShocked.png"
        DIALOGUE "Emilia" "You're doing all of this because you didn't want us to miss each other?"
        SHOW "man.png"
        DIALOGUE "Man" "...Don't read too much into it."
        SHOW "EmiliaShy.png"
        DIALOGUE "Emilia" "That's actually the sweetest thing I've ever heard."
        SHOW "man.png"
        DIALOGUE "Man" "I said don't—"
        SHOW "arthur.png"
        DIALOGUE "Arthur" "It's a little sweet."
        DIALOGUE "Man" "Morgan."
        DIALOGUE "Arthur" "It is what it is."
        SHOW "man.png"
        DIALOGUE "Man" "...Trial two passed. Somehow."
        JUMPTOSCENE "scene5_A"

    CHOICE "Confront your own doubts":
        DIALOGUE "You" "Emilia. Can I be honest about something harder?"
        SHOW "EmiliaShy.png"
        DIALOGUE "Emilia" "Always."
        DIALOGUE "You" "Sometimes I wonder if I deserve this. If I deserve you."
        SHOW "EmiliaShocked.png"
        DIALOGUE "Emilia" "What?! Y/N—"
        DIALOGUE "You" "I know how it sounds. But it's true."
        SHOW "EmiliaAngry.png"
        DIALOGUE "Emilia" "Listen to me right now."
        DIALOGUE "Emilia" "You are the first person who has ever made me feel like I'm not too much."
        DIALOGUE "Emilia" "You don't get to say you don't deserve that."
        DIALOGUE "You" "Emilia…"
        DIALOGUE "Emilia" "I mean it, Y/N."
        SHOW "arthur.png"
        DIALOGUE "Arthur" "Kid. Listen to her."
        SHOW "man.png"
        DIALOGUE "Man" "Trial two passed. That was the real courage."
        JUMPTOSCENE "scene5_A"


SCENE "scene5_A":
    BG "sakuraBG.jpg"
    SHOW "EmiliaHappy.png"
    DIALOGUE "Emilia" "Two down."
    DIALOGUE "You" "One to go."
    SHOW "EmiliaShy.png"
    DIALOGUE "Emilia" "Sacrifice. That one scares me the most."
    DIALOGUE "You" "Me too."
    SHOW "arthur.png"
    DIALOGUE "Arthur" "It should. Sacrifice is the one that costs you something real."
    SHOW "man.png"
    DIALOGUE "Man" "Are you ready?"
    TRANSITION "fade" "schoolHallwayBG.jpg"
    DIALOGUE "You" "What do we have to sacrifice?"
    SHOW "man.png"
    DIALOGUE "Man" "Not a thing. Never a thing."
    DIALOGUE "Man" "A choice."
    DIALOGUE "Man" "One of you must stay behind while the other walks through what comes next."
    SHOW "EmiliaShocked.png"
    DIALOGUE "Emilia" "Walk through what? Where?!"
    SHOW "man.png"
    DIALOGUE "Man" "Forward. Into the uncertain part."
    DIALOGUE "Man" "The part where nothing is guaranteed."
    SHOW "EmiliaShy.png"
    DIALOGUE "Emilia" "Y/N… I don't want to be left behind."
    DIALOGUE "You" "You won't be."
    SHOW "man.png"
    DIALOGUE "Man" "One must go first. That is the trial."
    SHOW "arthur.png"
    DIALOGUE "Arthur" "The one who goes first walks without knowing if the other will follow."
    DIALOGUE "Arthur" "That's the sacrifice. The certainty."
    CHOICES "You go first" "Ask Emilia to go first" "Refuse to separate"

    CHOICE "You go first":
        DIALOGUE "You" "I'll go."
        SHOW "EmiliaShocked.png"
        DIALOGUE "Emilia" "Y/N—"
        DIALOGUE "You" "I'll go. And I'll wait for you on the other side."
        SHOW "EmiliaShy.png"
        DIALOGUE "Emilia" "What if I can't follow?"
        DIALOGUE "You" "You will. You're braver than you think."
        SHOW "EmiliaHappy.png"
        DIALOGUE "Emilia" "...Don't go too far ahead."
        DIALOGUE "You" "Never."
        SHOW "arthur.png"
        DIALOGUE "Arthur" "Go, kid."
        SHOW "man.png"
        DIALOGUE "Man" "..."
        SHOW "EmiliaHappy.png"
        DIALOGUE "Emilia" "...I'm coming. Obviously."
        DIALOGUE "Emilia" "Did you really think I'd let you go alone?"
        DIALOGUE "You" "I hoped you wouldn't."
        SHOW "EmiliaShy.png"
        DIALOGUE "Emilia" "Idiot."
        SHOW "man.png"
        DIALOGUE "Man" "Trial three passed."
        JUMPTOSCENE "scene6_end"

    CHOICE "Ask Emilia to go first":
        DIALOGUE "You" "Emilia. I want you to go first."
        SHOW "EmiliaShocked.png"
        DIALOGUE "Emilia" "Me?! Why me?!"
        DIALOGUE "You" "Because I know I'll follow you anywhere."
        DIALOGUE "You" "I want you to know that I will come after you. No matter what."
        SHOW "EmiliaShy.png"
        DIALOGUE "Emilia" "...Y/N."
        DIALOGUE "You" "Go. I'll be right behind you."
        DIALOGUE "Emilia" "...You'd better be."
        SHOW "EmiliaHappy.png"
        DIALOGUE "Emilia" "...Okay. I'll go."
        SHOW "arthur.png"
        DIALOGUE "Arthur" "Good girl."
        SHOW "EmiliaAngry.png"
        DIALOGUE "Emilia" "Don't 'good girl' me—"
        DIALOGUE "You" "Emilia."
        SHOW "EmiliaShy.png"
        DIALOGUE "Emilia" "...Right. Going."
        DIALOGUE "You" "Right behind you."
        SHOW "man.png"
        DIALOGUE "Man" "Trial three passed."
        JUMPTOSCENE "scene6_end"

    CHOICE "Refuse to separate":
        DIALOGUE "You" "No."
        SHOW "man.png"
        DIALOGUE "Man" "The trial requires—"
        DIALOGUE "You" "No. We go together or we don't go."
        SHOW "arthur.png"
        DIALOGUE "Arthur" "Kid…"
        DIALOGUE "You" "The whole point of all of this was that we do this together. You said so."
        SHOW "man.png"
        DIALOGUE "Man" "I said no such thing."
        DIALOGUE "You" "You implied it."
        SHOW "EmiliaHappy.png"
        DIALOGUE "Emilia" "...Y/N is right."
        DIALOGUE "Emilia" "We're not splitting up. Final answer."
        SHOW "man.png"
        DIALOGUE "Man" "..."
        DIALOGUE "Man" "That was the trial."
        SHOW "EmiliaShocked.png"
        DIALOGUE "Emilia" "WHAT?!"
        SHOW "man.png"
        DIALOGUE "Man" "The sacrifice was the willingness to face uncertainty."
        DIALOGUE "Man" "You both showed it. Together, as it turns out."
        SHOW "arthur.png"
        DIALOGUE "Arthur" "...Sneaky."
        SHOW "man.png"
        DIALOGUE "Man" "I have my methods."
        DIALOGUE "Man" "Trial three passed."
        JUMPTOSCENE "scene6_end"


SCENE "scene6_end":
    BG "sakuraBG.jpg"
    SHOW "EmiliaHappy.png"
    DIALOGUE "Emilia" "...We did it."
    DIALOGUE "You" "We did it."
    SHOW "arthur.png"
    DIALOGUE "Arthur" "Not bad. For a couple of kids."
    SHOW "man.png"
    DIALOGUE "Man" "Three trials. Passed."
    DIALOGUE "Man" "I must say… you surprised me."
    SHOW "EmiliaAngry.png"
    DIALOGUE "Emilia" "Good. You deserved to be surprised after all that."
    SHOW "man.png"
    DIALOGUE "Man" "Ha."
    TRANSITION "fade" "schoolHallwayBG.jpg"
    SHOW "EmiliaShy.png"
    DIALOGUE "Emilia" "Y/N… is it over?"
    DIALOGUE "You" "I think so. For now."
    SHOW "arthur.png"
    DIALOGUE "Arthur" "It's never really over."
    DIALOGUE "You" "That's either wisdom or a threat."
    DIALOGUE "Arthur" "Both."
    SHOW "man.png"
    DIALOGUE "Man" "I'll be watching."
    SHOW "EmiliaAngry.png"
    DIALOGUE "Emilia" "Please stop saying that like it's comforting."
    SHOW "man.png"
    DIALOGUE "Man" "I'll be watching… warmly."
    SHOW "EmiliaAngry.png"
    DIALOGUE "Emilia" "That is somehow worse."
    CHOICES "Say goodbye to Arthur" "Say goodbye to the Man" "Ask if they'll stay"

    CHOICE "Say goodbye to Arthur":
        DIALOGUE "You" "Arthur. Thank you. For real."
        SHOW "arthur.png"
        DIALOGUE "Arthur" "Don't mention it."
        DIALOGUE "You" "I mean it. You didn't have to help us."
        DIALOGUE "Arthur" "No. I didn't."
        DIALOGUE "Arthur" "But you reminded me of something I'd almost forgotten."
        DIALOGUE "You" "What's that?"
        SHOW "arthur.png"
        DIALOGUE "Arthur" "That some things are worth fighting for."
        DIALOGUE "Arthur" "Not with guns. Just… worth it."
        SHOW "EmiliaHappy.png"
        DIALOGUE "Emilia" "Arthur Morgan everyone."
        SHOW "arthur.png"
        DIALOGUE "Arthur" "Don't push it, miss."
        DIALOGUE "Emilia" "...Thank you, Arthur."
        DIALOGUE "Arthur" "...You're welcome."
        SHOW "man.png"
        DIALOGUE "Man" "Until next time, Y/N. Emilia."
        DIALOGUE "You" "Will there be a next time?"
        SHOW "man.png"
        DIALOGUE "Man" "There's always a next time."
        SHOW "EmiliaShy.png"
        DIALOGUE "Emilia" "Y/N… whatever comes next."
        DIALOGUE "You" "Together."
        DIALOGUE "Emilia" "Together."
        SHOW "EmiliaHappy.png"
        DIALOGUE "Emilia" "...Don't make me say it was a good day. I refuse."
        DIALOGUE "You" "Was it a good day?"
        SHOW "EmiliaShy.png"
        DIALOGUE "Emilia" "...Shut up."
        DIALOGUE "You" "That's a yes."
        DIALOGUE "Emilia" "That is absolutely a yes."

    CHOICE "Say goodbye to the Man":
        DIALOGUE "You" "Hey. Narrator."
        SHOW "man.png"
        DIALOGUE "Man" "Yes?"
        DIALOGUE "You" "Why us? Really."
        SHOW "man.png"
        DIALOGUE "Man" "..."
        DIALOGUE "Man" "Because you looked at each other like you already knew."
        DIALOGUE "Man" "Most people never get that."
        SHOW "EmiliaShy.png"
        DIALOGUE "Emilia" "...Thank you. For not letting us miss it."
        SHOW "man.png"
        DIALOGUE "Man" "Thank yourself. I only cleared the path."
        DIALOGUE "Man" "You walked it."
        SHOW "arthur.png"
        DIALOGUE "Arthur" "Alright. Enough of this. I'm going to go find some food."
        SHOW "EmiliaHappy.png"
        DIALOGUE "Emilia" "Arthur wait— you literally live here now—"
        DIALOGUE "Arthur" "I know. I'm going to make stew."
        SHOW "EmiliaAngry.png"
        DIALOGUE "Emilia" "NOT THE MYSTERY STEW—"
        DIALOGUE "You" "I'll allow the mystery stew."
        DIALOGUE "Emilia" "Y/N!!"
        DIALOGUE "You" "It builds character."
        SHOW "EmiliaShy.png"
        DIALOGUE "Emilia" "...Fine. But if I get sick it's your fault."
        DIALOGUE "You" "I'll take full responsibility."
        SHOW "EmiliaHappy.png"
        DIALOGUE "Emilia" "...You're impossible."
        DIALOGUE "You" "You love it."
        DIALOGUE "Emilia" "...I really do."

    CHOICE "Ask if they'll stay":
        DIALOGUE "You" "Arthur. Man. What happens to you now?"
        SHOW "arthur.png"
        DIALOGUE "Arthur" "I go where I'm needed."
        SHOW "man.png"
        DIALOGUE "Man" "I watch. Always."
        DIALOGUE "You" "...Would it be weird to say we'd miss you?"
        SHOW "arthur.png"
        DIALOGUE "Arthur" "...A little."
        SHOW "EmiliaHappy.png"
        DIALOGUE "Emilia" "We'd miss you anyway."
        SHOW "arthur.png"
        DIALOGUE "Arthur" "..."
        DIALOGUE "Arthur" "...You're good kids."
        DIALOGUE "Arthur" "Don't waste it."
        SHOW "man.png"
        DIALOGUE "Man" "He means that as the highest compliment."
        DIALOGUE "Arthur" "I can speak for myself."
        DIALOGUE "Man" "I know. I simply enjoy narrating."
        SHOW "EmiliaAngry.png"
        DIALOGUE "Emilia" "Of course you do."
        SHOW "EmiliaShy.png"
        DIALOGUE "Emilia" "Y/N… I think this is it for now."
        DIALOGUE "You" "For now."
        DIALOGUE "Emilia" "...For now."
        SHOW "EmiliaHappy.png"
        DIALOGUE "Emilia" "But not forever."
        DIALOGUE "You" "Not even close to forever."
        DIALOGUE "Emilia" "...Good."